{
  "$schema": "vscode://schemas/color-theme",
  "name": "Pascal (Default)",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#9dd7ff",
    "type": "#a8b1ff",
    "class": "#a8b1ff",
    "enum": "#a8b1ff",
    "interface": "#a8b1ff",
    "struct": "#a8b1ff",
    "typeParameter": "#d8b4fe",
    "parameter": "#f7f7f8",
    "variable": "#f7f7f8",
    "property": "#c6ccff",
    "enumMember": "#f0b36f",
    "function": "#86efac",
    "method": "#86efac",
    "macro": "#86efac",
    "keyword": "#d8b4fe",
    "modifier": "#d8b4fe",
    "comment": "#7b7b86",
    "string": "#9dd7ff",
    "number": "#f0b36f",
    "regexp": "#f472b6",
    "operator": "#a2a2a9",
    "decorator": "#f472b6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "punctuation.definition.string.comment"
      ],
      "settings": {
        "foreground": "#7b7b86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "constant.character.escape",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9dd7ff"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#d8b4fe"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant"],
      "settings": {
        "foreground": "#f0b36f"
      }
    },
    {
      "name": "Types and constructors",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "meta.type.annotation",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#a8b1ff"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.object-literal.key.entity.name.function"
      ],
      "settings": {
        "foreground": "#86efac"
      }
    },
    {
      "name": "Parameters and variables",
      "scope": ["variable", "meta.definition.variable", "meta.definition.parameters"],
      "settings": {
        "foreground": "#f7f7f8"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.property-name",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c6ccff"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#a2a2a9"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "meta.import",
        "keyword.control.import",
        "keyword.control.from",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#9dd7ff"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.other.escape.regexp"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ff8080",
        "fontStyle": "underline"
      }
    }
  ],
  "colors": {
    "focusBorder": "#262626",
    "foreground": "#f7f7f8",
    "descriptionForeground": "#a2a2a9",
    "errorForeground": "#ff8080",
