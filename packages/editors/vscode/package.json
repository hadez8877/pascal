{
  "name": "pascal-vscode",
  "displayName": "Pascal for Visual Studio Code",
  "publisher": "hadez8877",
  "description": "A modern dark theme for many editors, shells, and more!",
  "version": "0.1.0-beta.6",
  "type": "commonjs",
  "icon": "icon.png",
  "main": "dist/extension.js",
  "browser": "dist/browser.js",
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hadez8877/pascal.git",
    "directory": "packages/editors/vscode"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs -- --minify",
    "lint": "biome lint . && eslint --cache --concurrency=auto ."
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.27.3",
    "eslint": "^10.7.0",
    "eslint-plugin-regexp": "^3.1.1",
    "kleur": "^4.1.5",
    "ovsx": "^0.10.12",
    "prettier": "^3.9.5",
    "tinyglobby": "^0.2.16",
    "turbo": "2.10.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "marked": "^18.0.6"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "pascal",
    "vsc-theme",
    "theme",
    "vscode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Pascal (Default)",
        "uiTheme": "vs-dark",
        "path": "themes/default.json"
      },
      {
        "label": "Pascal Solar",
        "uiTheme": "vs",
        "path": "themes/solar.json"
      }
    ],
    "commands": [
      {
        "command": "pascal.showChangelog",
        "title": "Pascal: Show Changelog"
      }
    ]
  },
  "configuration": {
    "title": "Pascal",
    "properties": {
      "pascal.editorTheme": {
        "type": "string",
        "default": "Pascal (Default)",
        "markdownDescription": "Switch to different editor theme",
        "enum": [
          "Pascal (Default)",
          "Pascal Solar"
        ]
      }
    }
  },
  "readme": "README.md",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  }
}
