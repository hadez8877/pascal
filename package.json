{
  "name": "pascal",
  "displayName": "Pascal",
  "publisher": "hadez8877",
  "description": "A modern dark theme for many editors, shells, and more!",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/extension.js",
  "browser": "./dist/browser.js",
  "categories": [
    "Themes"
  ],
  "icon": "./assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pascal.showChangelog",
        "title": "Show changelog",
        "category": "Pascal"
      }
    ],
    "themes": [
      {
        "label": "Pascal (Default)",
        "uiTheme": "vs-dark",
        "path": "./themes/default.json"
      }
    ]
  },
  "configuration": {
    "title": "Pascal",
    "properties": {
      "pascal.editorTheme": {
        "type": "string",
        "default": "Pascal (Default)",
        "markdownDescription": "Switch to different editor theme",
        "enum": [
          "Pascal (Default)"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hadez8877/pascal.git"
  },
  "bugs": {
    "url": "https://github.com/hadez8877/pascal/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -b",
    "lint": "biome lint . && eslint --cache --concurrency=auto .",
    "format": "pnpm run format:code && pnpm run format:imports",
    "format:code": "biome format --write && prettier -w \"**/*\" --ignore-unknown --cache",
    "format:imports": "biome check --formatter-enabled=false --write",
    "publish": "pnpm run build && pnpm dlx ovsx publish --no-dependencies",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.27.3",
    "eslint": "^10.4.0",
    "eslint-plugin-regexp": "^3.1.0",
    "piccolore": "0.1.3",
    "prettier": "^3.8.4",
    "tinyglobby": "0.2.16",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.88.0"
  },
  "packageManager": "pnpm@11.9.0"
}
